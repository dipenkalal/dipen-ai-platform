[Unit]
Description=Dipen AI Platform Backend
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=dipen
Group=dipen
WorkingDirectory=/home/dipen/dap/source/dipen-ai-platform/platform/backend
Environment=HOME=/home/dipen
Environment=PYTHONUNBUFFERED=1
Environment=OLLAMA_BASE_URL=http://127.0.0.1:11434
Environment=QDRANT_URL=http://127.0.0.1:6333
Environment=DAP_AGENT_HISTORY_DB=/home/dipen/dap/data/agent-history/agent-runs.db
Environment=KNOWLEDGE_UPLOAD_DIRECTORY=/home/dipen/dap/data/knowledge/uploads
ExecStart=/home/dipen/dap/source/dipen-ai-platform/platform/backend/.venv/bin/uvicorn app:app --host 0.0.0.0 --port 8002
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
