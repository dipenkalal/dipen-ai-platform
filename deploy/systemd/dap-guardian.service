[Unit]
Description=DAP Guardian Core
After=network-online.target
Wants=network-online.target
Before=dap-backend.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=dap-guardian
Group=dap-guardian
WorkingDirectory=/opt/dap/guardian

Environment=HOME=/var/lib/dap-guardian
Environment=PYTHONUNBUFFERED=1
Environment=DAP_GUARDIAN_HOST=0.0.0.0
Environment=DAP_GUARDIAN_PORT=8001
Environment=DAP_GUARDIAN_STATE_DIR=/var/lib/dap-guardian
EnvironmentFile=-/etc/dap/guardian.env

ExecStart=/usr/bin/python3 /opt/dap/guardian/control_plane.py

Restart=always
RestartSec=2
TimeoutStopSec=10

StateDirectory=dap-guardian
StateDirectoryMode=0770
RuntimeDirectory=dap-guardian
RuntimeDirectoryMode=0750

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

CapabilityBoundingSet=
AmbientCapabilities=

RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0007

[Install]
WantedBy=multi-user.target
