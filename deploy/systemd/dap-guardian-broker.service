[Unit]
Description=DAP Guardian Broker (Restricted Execution)
Requires=dap-guardian-broker.socket
After=dap-guardian-broker.socket

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/dap/guardian

Environment=PYTHONUNBUFFERED=1
Environment=DAP_GUARDIAN_BROKER_DATABASE=/var/lib/dap-guardian/actions.sqlite3
Environment=DAP_GUARDIAN_BROKER_AUTHORIZATION_DATABASE=/var/lib/dap-guardian-broker/authorizations.sqlite3
Environment=DAP_GUARDIAN_BROKER_ALLOWED_USER=dap-guardian
EnvironmentFile=-/etc/dap/guardian-broker.env

ExecStart=/usr/bin/python3 /opt/dap/guardian/broker_entrypoint.py

Restart=on-failure
RestartSec=1

StateDirectory=dap-guardian-broker
StateDirectoryMode=0700

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

CapabilityBoundingSet=
AmbientCapabilities=

RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
ReadOnlyPaths=/opt/dap/guardian
ReadWritePaths=/var/lib/dap-guardian /var/lib/dap-guardian-broker
UMask=0077
